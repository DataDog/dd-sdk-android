<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <android.widget.Toolbar
        android:id="@+id/legacy_toolbar"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="@color/datadog_violet"
        android:title="@string/legacy_toolbar_title"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/appcompat_toolbar"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="@color/datadog_violet"
        app:title="@string/appcompat_toolbar_title"
        app:layout_constraintTop_toBottomOf="@+id/legacy_toolbar" />

    <com.datadog.android.sample.sessionreplay.AppcompatToolbarCustomSubclass
        android:id="@+id/appcompat_subclass"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="@color/datadog_violet"
        app:title="@string/appcompat_toolbar_title"
        app:layout_constraintTop_toBottomOf="@+id/appcompat_toolbar" />

    <com.datadog.android.sample.sessionreplay.ToolbarCustomSubclass
        android:id="@+id/toolbar_subclass"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="@color/datadog_violet"
        android:title="@string/legacy_toolbar_title"
        app:layout_constraintTop_toBottomOf="@+id/appcompat_subclass" />

    <!--
        ImageContentDetector test: pure text, no other visual content at all — should stay
        visible even under ImagePrivacy.MASK_ALL, unlike PixelCaptureTestView below (which mixes
        text with the rings' substantial non-text ink). Placed above it, and before it in the
        layout, so it's guaranteed on-screen regardless of this (non-scrolling) fragment's height.
    -->
    <com.datadog.android.sample.sessionreplay.PixelCapturePureTextTestView
        android:id="@+id/pixel_capture_pure_text_test_view"
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@+id/toolbar_subclass"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!--
        PixelCapture SR test: a custom leaf View with no registered mapper.
        Without the PixelCapture fallback, SR records a blank rectangle here.
        With it, SR should record pixel-perfect concentric coloured rings, plus rows exercising
        the experimental text/input-field detection pass over pixel captures.
        Navigate: Home > Session Replay > Unsupported Views
    -->
    <com.datadog.android.sample.sessionreplay.PixelCaptureTestView
        android:id="@+id/pixel_capture_test_view"
        android:layout_width="match_parent"
        android:layout_height="580dp"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@+id/pixel_capture_pure_text_test_view"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>