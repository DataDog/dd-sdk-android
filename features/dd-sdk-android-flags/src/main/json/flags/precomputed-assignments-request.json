{
  "$schema": "http://json-schema.org/draft-07/schema",
  "title": "PrecomputedAssignmentsRequest",
  "type": "object",
  "properties": {
    "data": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "precompute-assignments-request"
        },
        "attributes": {
          "type": "object",
          "properties": {
            "env": {
              "type": "object",
              "properties": {
                "dd_env": {
                  "type": "string"
                }
              },
              "required": [
                "dd_env"
              ]
            },
            "source": {
              "type": "object",
              "properties": {
                "sdk_name": {
                  "type": "string",
                  "const": "dd-sdk-android"
                },
                "sdk_version": {
                  "type": "string"
                }
              },
              "required": [
                "sdk_name",
                "sdk_version"
              ]
            },
            "subject": {
              "type": "object",
              "properties": {
                "targeting_key": {
                  "type": "string"
                },
                "targeting_attributes": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "string"
                  }
                }
              },
              "required": [
                "targeting_key",
                "targeting_attributes"
              ]
            }
          },
          "required": [
            "env",
            "source",
            "subject"
          ]
        }
      },
      "required": [
        "type",
        "attributes"
      ]
    }
  },
  "required": [
    "data"
  ]
}
